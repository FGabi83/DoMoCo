datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String  @id @default(cuid())
  name     String  @default("")
  email    String  @unique @default("")
  password String?
  role     Role?   @relation("User_role", fields: [roleId], references: [id])
  roleId   String? @map("role")

  @@index([roleId])
}

model Role {
  id                          String  @id @default(cuid())
  name                        String  @unique @default("")
  canManageUsers              Boolean @default(false)
  canManageRoles              Boolean @default(false)
  canViewBuilding             Boolean @default(false)
  canManageBuildings          Boolean @default(false)
  canViewApartment            Boolean @default(false)
  canManageApartments         Boolean @default(false)
  canCreateIssue              Boolean @default(false)
  canEditOwnIssue             Boolean @default(false)
  canDeleteOwnIssue           Boolean @default(false)
  canEditAnyIssue             Boolean @default(false)
  canViewIssue                Boolean @default(false)
  canCreateDecision           Boolean @default(false)
  canVote                     Boolean @default(false)
  canViewDecision             Boolean @default(false)
  canViewOwnPaymentObligation Boolean @default(false)
  canManagePaymentObligation  Boolean @default(false)
  canViewOwnPayment           Boolean @default(false)
  canViewAnyPayment           Boolean @default(false)
  canManagePayment            Boolean @default(false)
  assignedTo                  User[]  @relation("User_role")
}
